# Copy to .env.local and fill in. Everything except ANTHROPIC_API_KEY is optional.

# AI co-founder
ANTHROPIC_API_KEY=
COFOUNDER_MODEL=claude-sonnet-5-5

# Market research. Hacker News, App Store reviews and Stack Exchange need nothing.
STACKEXCHANGE_KEY=                # free at stackapps.com, raises the daily limit
STACKEXCHANGE_SITES=softwarerecs,webapps,stackoverflow
BLUESKY_HANDLE=                   # free account, e.g. startit.bsky.social
BLUESKY_APP_PASSWORD=             # Bluesky Settings → App passwords

# Billing: Garage (free) · Launch · Scale. India → Razorpay, everyone else → Stripe.
# These same keys power the admin-only revenue sync on the Revenue screen.
STRIPE_SECRET_KEY=
STRIPE_PRICE_LAUNCH=              # price_… monthly Launch price ($9)
STRIPE_PRICE_SCALE=               # price_… monthly Scale price ($29)
STRIPE_WEBHOOK_SECRET=            # whsec_… from the webhook endpoint /api/billing/webhook/stripe
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_LAUNCH=             # plan_… monthly Launch plan (₹499)
RAZORPAY_PLAN_SCALE=              # plan_… monthly Scale plan (₹1,499)
RAZORPAY_WEBHOOK_SECRET=          # secret you set on the webhook /api/billing/webhook/razorpay

# Who may use server-wide integrations (revenue sync with the keys above). Comma-separated.
ADMIN_EMAILS=you@yourdomain.com

# Accounts + cloud storage (Supabase). Run supabase/schema.sql first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Push notifications (free, Web Push). Generate once: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

# Daily reminder job (app/api/cron/nudges, scheduled in vercel.json)
CRON_SECRET=
RESEND_API_KEY=                   # optional email copies + partner reports
REMINDER_FROM=STARTIT <coach@yourdomain.com>
